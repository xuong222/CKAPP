<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- CKAPP 定稿版：暖瓷底纸、灰绿雾面与少量梅色共同构成统一视觉语义。 -->
    <Color x:Key="Color.Window">#E8ECE9</Color>
    <Color x:Key="Color.Surface">#F8F9F6</Color>
    <Color x:Key="Color.SurfaceRaised">#F1F4F0</Color>
    <Color x:Key="Color.SurfaceHover">#E3EBE7</Color>
    <Color x:Key="Color.Border">#CDD6D2</Color>
    <Color x:Key="Color.BorderStrong">#AAB9B5</Color>
    <Color x:Key="Color.Primary">#3F5A61</Color>
    <Color x:Key="Color.PrimaryBright">#53747A</Color>
    <Color x:Key="Color.Normal">#4F7F70</Color>
    <Color x:Key="Color.Warning">#9C7837</Color>
    <Color x:Key="Color.Danger">#A94E57</Color>
    <Color x:Key="Color.TextPrimary">#26353C</Color>
    <Color x:Key="Color.TextSecondary">#506168</Color>
    <Color x:Key="Color.TextMuted">#7C8D91</Color>
    <Color x:Key="Color.InverseText">#F6F8F6</Color>
    <Color x:Key="Color.InverseMuted">#B9CBC7</Color>
    <Color x:Key="Color.Plum">#9D6677</Color>
    <Color x:Key="Color.Gold">#B69452</Color>
    <Color x:Key="Color.Console">#283D44</Color>
    <Color x:Key="Color.ConsoleDeep">#22343A</Color>
    <Color x:Key="Color.ConsoleTx">#E5B66F</Color>
    <Color x:Key="Color.ConsoleRx">#72C9BD</Color>

    <!-- 六要素只使用低饱和识别线与代码色，不形成大面积彩色块。 -->
    <Color x:Key="Color.SensorTemperature">#B76C5D</Color>
    <Color x:Key="Color.SensorSmoke">#A88B48</Color>
    <Color x:Key="Color.SensorPm">#5F7F9F</Color>
    <Color x:Key="Color.SensorCo">#4F8B82</Color>
    <Color x:Key="Color.SensorCo2">#747DA4</Color>
    <Color x:Key="Color.SensorSo2">#9B6E86</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="{StaticResource Color.Window}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceHover" Color="{StaticResource Color.SurfaceHover}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="{StaticResource Color.BorderStrong}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryBright" Color="{StaticResource Color.PrimaryBright}" />
    <SolidColorBrush x:Key="Brush.Normal" Color="{StaticResource Color.Normal}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.InverseText" Color="{StaticResource Color.InverseText}" />
    <SolidColorBrush x:Key="Brush.InverseMuted" Color="{StaticResource Color.InverseMuted}" />
    <SolidColorBrush x:Key="Brush.Plum" Color="{StaticResource Color.Plum}" />
    <SolidColorBrush x:Key="Brush.Gold" Color="{StaticResource Color.Gold}" />
    <SolidColorBrush x:Key="Brush.Console" Color="{StaticResource Color.Console}" />
    <SolidColorBrush x:Key="Brush.ConsoleDeep" Color="{StaticResource Color.ConsoleDeep}" />
    <SolidColorBrush x:Key="Brush.ConsoleTx" Color="{StaticResource Color.ConsoleTx}" />
    <SolidColorBrush x:Key="Brush.ConsoleRx" Color="{StaticResource Color.ConsoleRx}" />
    <SolidColorBrush x:Key="Brush.SensorTemperature" Color="{StaticResource Color.SensorTemperature}" />
    <SolidColorBrush x:Key="Brush.SensorSmoke" Color="{StaticResource Color.SensorSmoke}" />
    <SolidColorBrush x:Key="Brush.SensorPm" Color="{StaticResource Color.SensorPm}" />
    <SolidColorBrush x:Key="Brush.SensorCo" Color="{StaticResource Color.SensorCo}" />
    <SolidColorBrush x:Key="Brush.SensorCo2" Color="{StaticResource Color.SensorCo2}" />
    <SolidColorBrush x:Key="Brush.SensorSo2" Color="{StaticResource Color.SensorSo2}" />

    <LinearGradientBrush x:Key="Brush.WindowBackdrop" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F2EFE1" />
        <GradientStop Offset="0.48" Color="#E9EEEA" />
        <GradientStop Offset="1" Color="#DEE7E3" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.RailGradient" StartPoint="0,0" EndPoint="0.9,1">
        <GradientStop Offset="0" Color="#F6EED4" />
        <GradientStop Offset="0.42" Color="#F7F6EF" />
        <GradientStop Offset="1" Color="#F1E5E7" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.StageGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F2F5F1" />
        <GradientStop Offset="0.58" Color="#E9EFEB" />
        <GradientStop Offset="1" Color="#E4E8E5" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.NavigationActive" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#49676C" />
        <GradientStop Offset="1" Color="#2D454D" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ConsoleGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource Color.Console}" />
        <GradientStop Offset="1" Color="{StaticResource Color.ConsoleDeep}" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.ProgressGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0" Color="#8FB8AD" />
        <GradientStop Offset="0.52" Color="#D6C1C8" />
        <GradientStop Offset="1" Color="#9D6677" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush.NavigationThread" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="{StaticResource Color.Gold}" />
        <GradientStop Offset="1" Color="{StaticResource Color.Plum}" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FFF6E5" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#F8E9EB" />
</ResourceDictionary>
