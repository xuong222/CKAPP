<UserControl x:Class="CH32UpperComputer.App.Views.CommunicationLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1380">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock FontSize="17"
                           FontWeight="SemiBold"
                           Text="通信日志" />
                <Grid Grid.Row="1" Margin="0,9,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.Column="0" Margin="0,0,12,0" Content="TX" IsChecked="{Binding ShowTransmit}" />
                    <CheckBox Grid.Column="1" Margin="0,0,12,0" Content="RX" IsChecked="{Binding ShowReceive}" />
                    <CheckBox Grid.Column="2" Margin="0,0,12,0" Content="Error" IsChecked="{Binding ShowError}" />
                    <CheckBox Grid.Column="3" Margin="0,0,12,0" Content="Late" IsChecked="{Binding ShowLate}" />
                    <CheckBox Grid.Column="4" Margin="0,0,16,0" Content="System" IsChecked="{Binding ShowSystem}" />
                    <TextBox Grid.Column="5"
                             Margin="0,0,8,0"
                             ToolTip="摘要或原始十六进制关键字"
                             Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBox Grid.Column="6"
                             Margin="0,0,8,0"
                             ToolTip="事务编号"
                             Text="{Binding TransactionIdText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="8"
                            Margin="8,0,0,0"
                            Command="{Binding ApplyFilterCommand}"
                            Content="应用筛选" />
                </Grid>
            </Grid>
        </Border>

        <ListView Grid.Row="1"
                  Margin="0,10"
                  Background="{DynamicResource Brush.Surface}"
                  BorderBrush="{DynamicResource Brush.Border}"
                  BorderThickness="1"
                  ItemsSource="{Binding Entries}"
                  ScrollViewer.CanContentScroll="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.View>
                <GridView AllowsColumnReorder="False">
                    <GridViewColumn Width="72" Header="#" DisplayMemberBinding="{Binding SequenceId}" />
                    <GridViewColumn Width="120" Header="时间" DisplayMemberBinding="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" />
                    <GridViewColumn Width="85" Header="方向" DisplayMemberBinding="{Binding Direction}" />
                    <GridViewColumn Width="90" Header="事务" DisplayMemberBinding="{Binding TransactionId}" />
                    <GridViewColumn Width="115" Header="状态" DisplayMemberBinding="{Binding State}" />
                    <GridViewColumn Width="580" Header="原始数据" DisplayMemberBinding="{Binding RawHex}" />
                    <GridViewColumn Width="420" Header="摘要" DisplayMemberBinding="{Binding Summary}" />
                </GridView>
            </ListView.View>
        </ListView>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center"
                           Style="{StaticResource Text.Caption}"
                           Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis" />
                <TextBox Grid.Column="1"
                         Margin="8,0"
                         Text="{Binding ExportDirectory, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="2"
                        Margin="0,0,8,0"
                        Command="{Binding ExportCommand}"
                        Content="导出 UTF-8 CSV" />
                <Button Grid.Column="3"
                        Style="{StaticResource Button.Danger}"
                        Command="{Binding ClearCommand}"
                        Content="清空日志" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
