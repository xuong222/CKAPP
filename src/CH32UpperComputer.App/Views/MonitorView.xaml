<UserControl x:Class="CH32UpperComputer.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="790"
             d:DesignWidth="1150">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.92*" MinHeight="290" />
            <RowDefinition Height="10" />
            <RowDefinition Height="1.08*" MinHeight="280" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <ItemsControl x:Name="SensorCardsItemsControl"
                          Grid.Column="0"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding Monitor.SensorCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,8,8"
                                Padding="12"
                                Background="#EAF8F9F6"
                                BorderThickness="1,3,1,1"
                                CornerRadius="12"
                                MouseEnter="HandleSensorCardMouseEnter"
                                MouseLeave="HandleSensorCardMouseLeave">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush"
                                            Value="{DynamicResource Brush.Border}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DocumentAddress}" Value="40003">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource Brush.SensorTemperature}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DocumentAddress}" Value="40004">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource Brush.SensorSmoke}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DocumentAddress}" Value="40005">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource Brush.SensorPm}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DocumentAddress}" Value="40006">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource Brush.SensorCo}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DocumentAddress}" Value="40007">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource Brush.SensorCo2}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DocumentAddress}" Value="40008">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource Brush.SensorSo2}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold"
                                               Text="{Binding Title}" />
                                    <TextBlock Grid.Column="1"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="9"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource Brush.TextMuted}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DocumentAddress}" Value="40003">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Brush.SensorTemperature}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentAddress}" Value="40004">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Brush.SensorSmoke}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentAddress}" Value="40005">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Brush.SensorPm}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentAddress}" Value="40006">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Brush.SensorCo}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentAddress}" Value="40007">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Brush.SensorCo2}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding DocumentAddress}" Value="40008">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource Brush.SensorSo2}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} · {1}">
                                                <Binding Path="Symbol" />
                                                <Binding Path="DocumentAddress" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </Grid>
                                <StackPanel Grid.Row="1"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <TextBlock FontFamily="Cascadia Mono, Consolas"
                                               FontSize="34"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               Text="{Binding ValueText}" />
                                    <TextBlock Margin="7,12,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Text="{Binding Unit}" />
                                </StackPanel>
                                <Border Grid.Row="2"
                                        Margin="0,6,0,0"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,1,0,0">
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource Text.Muted}"
                                                   Text="显示值" />
                                        <Border Grid.Column="1"
                                                Padding="6,2"
                                                Background="#99E3EBE7"
                                                CornerRadius="8">
                                            <TextBlock FontSize="9"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding StateText}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="1"
                    Padding="13"
                    Style="{StaticResource Card.Console}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.InverseText}"
                                   Text="报警信息" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="8"
                                   Foreground="{DynamicResource Brush.InverseMuted}"
                                   Text="40009 / 40010" />
                    </Grid>
                    <Border Grid.Row="1"
                            Margin="0,10,0,8"
                            Padding="10"
                            Background="#0EFFFFFF"
                            BorderBrush="#2DFFFFFF"
                            BorderThickness="1"
                            CornerRadius="11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="14"
                                     Height="14"
                                     HorizontalAlignment="Left"
                                     Stroke="{DynamicResource Brush.InverseMuted}"
                                     StrokeThickness="2" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.InverseText}"
                                           Text="{Binding Monitor.OverallStateText}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="9"
                                           Foreground="{DynamicResource Brush.InverseMuted}"
                                           Text="{Binding Monitor.AlarmSummary}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl Grid.Row="2"
                                  ItemsSource="{Binding Monitor.AlarmItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,5,5"
                                        Padding="7,5"
                                        Background="#09FFFFFF"
                                        BorderBrush="#20FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="9"
                                                   Foreground="{DynamicResource Brush.InverseText}"
                                                   Text="{Binding DisplayName}" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource Brush.InverseMuted}"
                                                   Text="{Binding StateText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Grid.Row="3"
                            Padding="0,7,0,0"
                            BorderBrush="#24FFFFFF"
                            BorderThickness="0,1,0,0">
                        <TextBlock FontSize="8"
                                   Foreground="{DynamicResource Brush.InverseMuted}"
                                   Text="{Binding Monitor.LastUpdatedText, StringFormat=最近更新：{0}}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1"
                      Margin="0,2"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Style="{StaticResource Splitter.Industrial}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="11"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Top"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="数据收发" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Margin="0,0,12,0" Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.SendCount, StringFormat=发送 {0}}" />
                            <TextBlock Margin="0,0,12,0" Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.SuccessCount, StringFormat=成功 {0}}" />
                            <TextBlock Margin="0,0,12,0" Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.FailureCount, StringFormat=失败/超时 {0}}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.LastSendTimeText, StringFormat=最近 {0}}" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1"
                             Padding="8"
                             Background="{DynamicResource Brush.ConsoleGradient}"
                             BorderBrush="#334F5960"
                             BorderThickness="1"
                             Foreground="{DynamicResource Brush.InverseText}"
                             ItemsSource="{Binding CommunicationLog.Entries}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.InverseText}" />
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               Foreground="{DynamicResource Brush.InverseMuted}"
                                               Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" />
                                    <TextBlock Grid.Column="1"
                                               FontFamily="Cascadia Mono, Consolas"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#A9CBC1"
                                               Text="{Binding Direction}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.InverseText}"
                                                   Text="{Binding RawHex}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock FontSize="9"
                                                   Foreground="{DynamicResource Brush.InverseMuted}"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="0,7,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox MinHeight="36"
                                     FontFamily="Cascadia Mono, Consolas"
                                     Text="{Binding CommandConsole.InputText, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Grid.Column="1"
                                      Margin="10,0"
                                      Content="自动 CRC"
                                      IsChecked="{Binding CommandConsole.AutoAppendCrc}" />
                            <TextBox Grid.Column="2"
                                     Margin="0,0,7,0"
                                     Text="{Binding CommandConsole.PeriodicIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="3"
                                    Margin="0,0,7,0"
                                    Command="{Binding CommandConsole.StartPeriodicCommand}"
                                    Content="定时发送" />
                            <Button Grid.Column="4"
                                    Margin="0,0,7,0"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding CommandConsole.SendCommand}"
                                    Content="发送" />
                            <Button Grid.Column="5"
                                    Command="{Binding CommandConsole.StopPeriodicCommand}"
                                    Content="停止定时" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="1,5,1,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Muted}"
                                       Text="{Binding CommandConsole.StatusMessage}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource Text.Muted}"
                                       Text="{Binding CommandConsole.LastResponseDurationText, StringFormat=耗时 {0}}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="11"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="常用指令" />
                        <TextBlock Grid.Column="1"
                                   FontFamily="Cascadia Mono, Consolas"
                                   FontSize="8"
                                   Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="QUICK" />
                    </Grid>
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,9,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CommandConsole.CommonCommands}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button MinHeight="38"
                                            Margin="0,0,0,6"
                                            Padding="8,5"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding SelectCommand}">
                                        <StackPanel>
                                            <TextBlock FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="8"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       Text="{Binding Description}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <Border Grid.Row="2"
                            Padding="0,7,0,0"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="0,1,0,0">
                        <TextBlock FontSize="8"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="未知地址查询仅适用于总线上只有一个设备。"
                                   TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
