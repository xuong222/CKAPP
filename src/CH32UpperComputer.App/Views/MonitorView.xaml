<UserControl x:Class="CH32UpperComputer.App.Views.MonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1380">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" MinHeight="250" />
            <RowDefinition Height="12" />
            <RowDefinition Height="2*" MinHeight="220" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <ItemsControl Grid.Column="0"
                          Margin="0,0,10,0"
                          ItemsSource="{Binding Monitor.SensorCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="2" Columns="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,10,10"
                                Padding="17"
                                Background="{DynamicResource Brush.Surface}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tone}" Value="Normal">
                                            <Setter Property="BorderBrush" Value="#305D63" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock FontSize="19"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Title}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource Text.Caption}"
                                                   Text="{Binding DocumentAddress, StringFormat=寄存器 {0}}" />
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            Background="{DynamicResource Brush.SurfaceRaised}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource Brush.PrimaryBright}"
                                                   Text="{Binding Symbol}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock FontFamily="Bahnschrift, Microsoft YaHei UI"
                                                   FontSize="43"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   Text="{Binding ValueText}" />
                                        <TextBlock Margin="8,17,0,0"
                                                   FontSize="15"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   Text="{Binding Unit}" />
                                    </StackPanel>
                                </StackPanel>
                                <Border Grid.Row="2"
                                        Padding="8,5"
                                        Background="{DynamicResource Brush.SurfaceRaised}"
                                        CornerRadius="4">
                                    <TextBlock HorizontalAlignment="Center"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.Normal}"
                                               Text="{Binding StateText}"
                                               TextTrimming="CharacterEllipsis" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="报警信息" />
                        <Border Grid.Column="1"
                                Padding="9,4"
                                Background="{DynamicResource Brush.SurfaceRaised}"
                                CornerRadius="10">
                            <TextBlock FontSize="11" Text="40009 / 40010" />
                        </Border>
                    </Grid>
                    <Border Grid.Row="1"
                            Margin="0,14,0,12"
                            Padding="12"
                            BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <StackPanel>
                            <TextBlock FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Normal}"
                                       Text="{Binding Monitor.OverallStateText}" />
                            <TextBlock Margin="0,5,0,0"
                                       Style="{StaticResource Text.Caption}"
                                       Text="{Binding Monitor.AlarmSummary}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Monitor.AlarmItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,5"
                                            Padding="9,6"
                                            Background="{DynamicResource Brush.SurfaceRaised}"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            CornerRadius="5">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="7" Height="7">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource Brush.Normal}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Fill" Value="{DynamicResource Brush.TextMuted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayName}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="{Binding StateText}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="3"
                               Margin="0,8,0,0"
                               Style="{StaticResource Text.Muted}"
                               Text="{Binding Monitor.LastUpdatedText, StringFormat=最近更新：{0}}" />
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="1"
                      Margin="0,2"
                      HorizontalAlignment="Stretch"
                      ResizeDirection="Rows"
                      Style="{StaticResource Splitter.Industrial}" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="270" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="0"
                    Background="{DynamicResource Brush.Surface}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="42" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="数据收发" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,14,0" Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.SendCount, StringFormat=发送 {0}}" />
                            <TextBlock Margin="0,0,14,0" Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.SuccessCount, StringFormat=成功 {0}}" />
                            <TextBlock Margin="0,0,14,0" Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.FailureCount, StringFormat=失败/超时 {0}}" />
                            <TextBlock Style="{StaticResource Text.Muted}" Text="{Binding CommandConsole.LastSendTimeText, StringFormat=最近 {0}}" />
                        </StackPanel>
                    </Grid>
                    <ListBox Grid.Row="1"
                             Margin="10,0"
                             Padding="2"
                             Background="{DynamicResource Brush.Window}"
                             BorderBrush="{DynamicResource Brush.Border}"
                             BorderThickness="1"
                             ItemsSource="{Binding CommunicationLog.Entries}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Visible"
                             HorizontalContentAlignment="Stretch"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="7,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontFamily="Consolas"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{Binding Timestamp, StringFormat=HH:mm:ss.fff}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{DynamicResource Brush.PrimaryBright}"
                                               Text="{Binding Direction}" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock FontFamily="Consolas"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                   Text="{Binding RawHex}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource Brush.TextMuted}"
                                                   Text="{Binding Summary}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="2" Margin="10,8,10,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     MinHeight="38"
                                     MaxHeight="82"
                                     FontFamily="Consolas"
                                     TextWrapping="Wrap"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     Text="{Binding CommandConsole.InputText, UpdateSourceTrigger=PropertyChanged}" />
                            <CheckBox Grid.Column="1"
                                      Margin="10,0"
                                      Content="自动 CRC"
                                      IsChecked="{Binding CommandConsole.AutoAppendCrc}" />
                            <TextBox Grid.Column="2"
                                     Margin="0,0,8,0"
                                     Text="{Binding CommandConsole.PeriodicIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="3"
                                    Margin="0,0,8,0"
                                    Command="{Binding CommandConsole.StartPeriodicCommand}"
                                    Content="定时发送" />
                            <Button Grid.Column="4"
                                    Style="{StaticResource Button.Primary}"
                                    Command="{Binding CommandConsole.SendCommand}"
                                    Content="发送" />
                        </Grid>
                        <Grid Grid.Row="1" Margin="2,6,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Text.Muted}"
                                       Text="{Binding CommandConsole.StatusMessage}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBlock Margin="0,0,10,0"
                                           Style="{StaticResource Text.Muted}"
                                           Text="{Binding CommandConsole.LastResponseDurationText, StringFormat=耗时 {0}}" />
                                <Button Padding="9,2"
                                        Command="{Binding CommandConsole.StopPeriodicCommand}"
                                        Content="停止定时" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource Text.SectionTitle}" Text="常用指令" />
                    <ScrollViewer Grid.Row="1"
                                  Margin="0,10,0,0"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding CommandConsole.CommonCommands}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,0,0,6"
                                            Padding="9,7"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding SelectCommand}">
                                        <StackPanel>
                                            <TextBlock FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Margin="0,3,0,0"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       Text="{Binding Description}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
