<UserControl x:Class="CH32UpperComputer.App.Views.ParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1380">
    <UserControl.Resources>
        <Style x:Key="AlarmMask.Toggle"
               TargetType="ToggleButton">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel HorizontalAlignment="Center"
                                        Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot"
                                         Width="7"
                                         Height="7"
                                         Margin="0,0,6,0"
                                         Fill="{DynamicResource Brush.TextMuted}" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.Primary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground"
                                        Value="{DynamicResource Brush.PrimaryBright}" />
                                <Setter TargetName="ToggleBorder"
                                        Property="Background"
                                        Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter TargetName="ToggleBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.PrimaryBright}" />
                                <Setter TargetName="StatusDot"
                                        Property="Fill"
                                        Value="{DynamicResource Brush.Normal}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ToggleBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ParameterGrid.CenteredText"
               TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ParameterGrid.SelectionCheckBox"
               TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="HitArea"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <Grid Width="20"
                                  Height="20"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center">
                                <Border x:Name="CheckBoxBody"
                                        Background="{DynamicResource Brush.Window}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="3" />
                                <Path x:Name="CheckMark"
                                      Width="12"
                                      Height="9"
                                      Data="M 1 4.5 L 4.5 8 L 11 1"
                                      Stroke="{DynamicResource Brush.Window}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2"
                                      Stretch="Fill"
                                      Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HitArea"
                                        Property="Background"
                                        Value="{DynamicResource Brush.SurfaceHover}" />
                                <Setter TargetName="CheckBoxBody"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.PrimaryBright}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxBody"
                                        Property="Background"
                                        Value="{DynamicResource Brush.Primary}" />
                                <Setter TargetName="CheckBoxBody"
                                        Property="BorderBrush"
                                        Value="{DynamicResource Brush.PrimaryBright}" />
                                <Setter TargetName="CheckMark"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="HitArea"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ParameterGrid.Row"
               TargetType="DataGridRow"
               BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Style.Triggers>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="AlternationIndex" Value="0" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background"
                            Value="{DynamicResource Brush.Surface}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Brush.TextPrimary}" />
                </MultiTrigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="AlternationIndex" Value="1" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background"
                            Value="{DynamicResource Brush.SurfaceRaised}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Brush.TextPrimary}" />
                </MultiTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Brush.SurfaceHover}" />
                    <Setter Property="Foreground"
                            Value="{DynamicResource Brush.PrimaryBright}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ParameterGrid.Cell"
               TargetType="DataGridCell"
               BasedOn="{StaticResource {x:Type DataGridCell}}">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderBrush"
                            Value="{DynamicResource Brush.Border}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource Card}"
                Background="{DynamicResource Brush.SurfaceRaised}"
                BorderBrush="{DynamicResource Brush.Primary}"
                Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="17"
                               FontWeight="SemiBold"
                               Text="参数读取与寄存器修改" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="完整列出 40001～40036；连接后保持静默，由用户选择单项、批量或全部读取。"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{DynamicResource Brush.PrimaryBright}"
                               Text="{Binding SelectionSummary}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               Text="{Binding StatusMessage}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Command="{Binding ReadAllCommand}"
                            Content="一键读取全部" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding ReadSelectedCommand}"
                            Content="读取选中"
                            ToolTip="{Binding SelectionSummary}" />
                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding ModifySelectedCommand}"
                            Content="修改选中"
                            ToolTip="{Binding SelectionSummary}" />
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid x:Name="RegistersGrid"
                  Grid.Row="1"
                  Margin="0,10"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  CellStyle="{StaticResource ParameterGrid.Cell}"
                  FrozenColumnCount="3"
                  IsReadOnly="False"
                  ItemsSource="{Binding Registers}"
                  MinRowHeight="46"
                  RowStyle="{StaticResource ParameterGrid.Row}"
                  AlternationCount="2"
                  EnableRowVirtualization="False"
                  EnableColumnVirtualization="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="False">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="68" Header="选择">
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="DataGridCell"
                               BasedOn="{StaticResource ParameterGrid.Cell}">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="VerticalContentAlignment"
                                    Value="Stretch" />
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox Style="{StaticResource ParameterGrid.SelectionCheckBox}"
                                      IsChecked="{Binding IsSelected,
                                                          Mode=TwoWay,
                                                          UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="78"
                                    Header="地址"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding AddressText}" />
                <DataGridTemplateColumn Width="165" Header="寄存器名称">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Padding="7,4"
                                    Command="{Binding DataContext.SelectItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Content="{Binding Definition.Name}"
                                    ToolTip="{Binding Definition.ValueDescription}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="82"
                                    Header="权限"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding AccessText}" />
                <DataGridTextColumn Width="135"
                                    Header="当前值"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding CurrentValueText}" />
                <DataGridTextColumn Width="82"
                                    Header="Signed"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding SignedValueText}" />
                <DataGridTextColumn Width="82"
                                    Header="Unsigned"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding UnsignedValueText}" />
                <DataGridTextColumn Width="82"
                                    Header="Hex"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding HexadecimalValueText}" />
                <DataGridTextColumn Width="105"
                                    Header="单位"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding Definition.Unit}" />
                <DataGridTemplateColumn Width="330" Header="准备写入">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid Margin="3">
                                <TextBox x:Name="RegularInput"
                                         VerticalContentAlignment="Center"
                                         TextAlignment="Center"
                                         IsEnabled="{Binding CanEdit}"
                                         Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{Binding InputHint}" />
                                <Border x:Name="AlarmMaskEditor"
                                        Visibility="Collapsed"
                                        Padding="8"
                                        Background="{DynamicResource Brush.SurfaceRaised}"
                                        BorderBrush="{DynamicResource Brush.BorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                                       Text="掩码值" />
                                            <TextBox Grid.Column="1"
                                                     Height="30"
                                                     Margin="8,0"
                                                     Padding="7,4"
                                                     VerticalContentAlignment="Center"
                                                     TextAlignment="Center"
                                                     IsEnabled="{Binding CanEdit}"
                                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                                     ToolTip="{Binding InputHint}" />
                                            <TextBlock Grid.Column="2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextMuted}"
                                                       Text="低 6 位 · 点击通道切换"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                        <ItemsControl Grid.Row="1"
                                                      Margin="0,8,0,-6"
                                                      ItemsSource="{Binding AlarmBits}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Style="{StaticResource AlarmMask.Toggle}"
                                                                  Content="{Binding DisplayName}"
                                                                  IsChecked="{Binding IsEnabled}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsAlarmMask}" Value="True">
                                    <Setter TargetName="RegularInput"
                                            Property="Visibility"
                                            Value="Collapsed" />
                                    <Setter TargetName="AlarmMaskEditor"
                                            Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Width="82"
                                    Header="写入原始字"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding RawPreview}" />
                <DataGridTextColumn Width="210"
                                    Header="校验说明"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ParameterGrid.CenteredText}"
                                    Binding="{Binding ValidationMessage}" />
                <DataGridTemplateColumn Width="150" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                <Button Margin="0,0,6,0"
                                        Padding="9,4"
                                        Command="{Binding DataContext.ReadItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="读取" />
                                <Button Padding="9,4"
                                        Command="{Binding DataContext.ModifyItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Content="修改" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.05*" />
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Style="{StaticResource Card}"
                    Padding="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}"
                               Text="修改设备地址" />
                    <TextBlock Margin="0,4,0,8"
                               Style="{StaticResource Text.Muted}"
                               Text="40001 使用独立 0x06 安全流程。"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="90"
                                 Text="{Binding TargetSlaveAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding ChangeAddressCommand}"
                                Content="下发地址" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="1"
                    Margin="0,0,8,0"
                    Style="{StaticResource Card}"
                    Padding="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}"
                               Text="修改波特率" />
                    <TextBlock Margin="0,4,0,8"
                               Style="{StaticResource Text.Muted}"
                               Text="40002 完整回显后重连。"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="110"
                                  ItemsSource="{Binding DataContext.SerialConnection.BaudRates, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding TargetBaudRate}" />
                        <Button Margin="8,0,0,0"
                                Command="{Binding ChangeBaudRateCommand}"
                                Content="下发并重连" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Column="2"
                    Margin="0,0,8,0"
                    Style="{StaticResource Card}"
                    Padding="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}"
                               Text="0xFE 未知地址查询" />
                    <TextBlock Margin="0,4,0,7"
                               Foreground="{DynamicResource Brush.Warning}"
                               Text="{Binding UnknownAddressWarning}"
                               TextWrapping="Wrap" />
                    <Button HorizontalAlignment="Left"
                            Command="{Binding DiscoverAddressCommand}"
                            Content="确认单设备并查询" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3"
                    Style="{StaticResource Card}"
                    Padding="12">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.SectionTitle}"
                               Text="恢复出厂" />
                    <TextBlock Margin="0,4,0,7"
                               Foreground="{DynamicResource Brush.Danger}"
                               Text="40036 写入 1 后恢复地址 1、9600-8-N-1；定时发送保持关闭。"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <CheckBox Margin="0,0,8,0"
                                  Content="我已确认"
                                  IsChecked="{Binding FactoryResetConfirmed}" />
                        <Button Style="{StaticResource Button.Danger}"
                                Command="{Binding RestoreFactoryCommand}"
                                Content="恢复出厂" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
