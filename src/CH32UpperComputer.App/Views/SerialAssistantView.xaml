<UserControl x:Class="CH32UpperComputer.App.Views.SerialAssistantView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="790"
             d:DesignWidth="1150">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,9"
                Padding="12"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="0.72*" />
                    <ColumnDefinition Width="0.82*" />
                    <ColumnDefinition Width="0.82*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="独立串口" />
                    <ComboBox ItemsSource="{Binding AvailablePorts}"
                              IsEditable="True"
                              IsEnabled="{Binding CanEditSerialSettings}"
                              DropDownOpened="HandleSerialPortDropDownOpened"
                              TextSearch.TextPath="PortName"
                              Text="{Binding PortName, UpdateSourceTrigger=PropertyChanged}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="{Binding DisplayName}"
                                           TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="波特率" />
                    <ComboBox ItemsSource="{Binding BaudRates}"
                              IsEnabled="{Binding CanEditSerialSettings}"
                              SelectedItem="{Binding BaudRate}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="数据位" />
                    <ComboBox ItemsSource="{Binding DataBitOptions}"
                              IsEnabled="{Binding CanEditSerialSettings}"
                              SelectedItem="{Binding DataBits}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="校验" />
                    <ComboBox ItemsSource="{Binding ParityOptions}"
                              IsEnabled="{Binding CanEditSerialSettings}"
                              SelectedItem="{Binding Parity}" />
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Style="{StaticResource Text.Muted}" Text="停止位" />
                    <ComboBox ItemsSource="{Binding StopBitOptions}"
                              IsEnabled="{Binding CanEditSerialSettings}"
                              SelectedItem="{Binding StopBits}" />
                </StackPanel>
                <StackPanel Grid.Column="5"
                            VerticalAlignment="Bottom"
                            Orientation="Horizontal">
                    <Button Margin="0,0,7,0"
                            Command="{Binding RefreshPortsCommand}"
                            Content="刷新串口" />
                    <Button Margin="0,0,7,0"
                            Style="{StaticResource Button.Primary}"
                            Command="{Binding ConnectCommand}"
                            Content="连接" />
                    <Button Command="{Binding DisconnectCommand}" Content="断开" />
                </StackPanel>

                <Grid Grid.Row="1" Grid.ColumnSpan="6" Margin="0,7,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   Text="{Binding PortDiscoveryStatus}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource Brush.Danger}"
                                   Text="{Binding ErrorMessage}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.Normal}"
                               FontWeight="SemiBold"
                               Text="{Binding ConnectionStatus}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="370" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,9,0"
                    Padding="11"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="0,0,14,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.SectionTitle}"
                                       Text="数据画布（TX / RX）" />
                            <TextBlock Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.Muted}"
                                       Text="显示" />
                            <ComboBox Width="88"
                                      Margin="0,0,12,0"
                                      ItemsSource="{Binding DataModeOptions}"
                                      SelectedValue="{Binding ReceiveMode}"
                                      SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox Margin="0,0,12,0"
                                      IsChecked="{Binding ShowTimestamps}"
                                      Content="时间戳" />
                            <CheckBox IsChecked="{Binding AutoScroll}"
                                      Content="自动滚动" />
                        </StackPanel>
                        <StackPanel Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button Margin="0,0,7,0"
                                    Command="{Binding TogglePauseCommand}"
                                    Content="{Binding PauseButtonText}" />
                            <Button Margin="0,0,7,0"
                                    Command="{Binding ClearCommand}"
                                    Content="清空画布" />
                            <Button Click="HandleSaveClick" Content="保存当前视图" />
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="TrafficCanvasListBox"
                             Grid.Row="1"
                             Padding="13,14,13,4"
                             Background="{DynamicResource Brush.ConsoleGradient}"
                             BorderBrush="#334F5960"
                             BorderThickness="1"
                             Focusable="False"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="11"
                             ItemsSource="{Binding TrafficRecords}"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <Setter Property="Padding" Value="0" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,13"
                                        Padding="10,0,0,0"
                                        BorderThickness="2,0,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush"
                                                    Value="{DynamicResource Brush.ConsoleRx}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTransmit}" Value="True">
                                                    <Setter Property="BorderBrush"
                                                            Value="{DynamicResource Brush.ConsoleTx}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding HeaderText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground"
                                                            Value="{DynamicResource Brush.ConsoleRx}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTransmit}" Value="True">
                                                            <Setter Property="Foreground"
                                                                    Value="{DynamicResource Brush.ConsoleTx}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Margin="28,3,0,0"
                                                   Foreground="{DynamicResource Brush.InverseText}"
                                                   Text="{Binding PayloadText}"
                                                   TextWrapping="NoWrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="11"
                    Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.SectionTitle}"
                                   Text="发送" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Margin="0,0,5,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource Text.Muted}"
                                       Text="发送模式" />
                            <ComboBox Width="86"
                                      Margin="0,0,8,0"
                                      ItemsSource="{Binding DataModeOptions}"
                                      IsEnabled="{Binding CanEditPayload}"
                                      SelectedValue="{Binding SendMode}"
                                      SelectedValuePath="Value">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <CheckBox IsEnabled="{Binding CanEditPayload}"
                                      IsChecked="{Binding AppendNewLine}"
                                      Content="发送新行" />
                        </StackPanel>
                    </Grid>
                    <TextBox Grid.Row="1"
                             MinHeight="150"
                             Padding="10"
                             AcceptsReturn="True"
                             FontFamily="Cascadia Mono, Consolas"
                             HorizontalScrollBarVisibility="Auto"
                             IsEnabled="{Binding CanEditPayload}"
                             Text="{Binding SendText, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <Grid Grid.Row="2" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource Text.Caption}"
                                   Text="定时间隔 ms" />
                        <TextBox Grid.Column="1"
                                 Margin="10,0,0,0"
                                 IsEnabled="{Binding CanEditPayload}"
                                 Text="{Binding PeriodicIntervalMilliseconds, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <UniformGrid Grid.Row="3" Margin="0,9,0,0" Columns="3">
                        <Button Margin="0,0,6,0"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding SendCommand}"
                                Content="发送" />
                        <Button Margin="0,0,6,0"
                                Command="{Binding StartPeriodicCommand}"
                                Content="定时发送" />
                        <Button Command="{Binding StopPeriodicCommand}" Content="停止" />
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,9,0,0"
                Padding="11,8"
                Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Foreground="{DynamicResource Brush.Normal}"
                           FontWeight="SemiBold"
                           Text="{Binding ConnectionStatus}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}">
                        <Run Text="TX 次数 " />
                        <Run FontWeight="SemiBold" Text="{Binding TransmitOperationCount}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}">
                        <Run Text="TX 字节 " />
                        <Run FontWeight="SemiBold" Text="{Binding TransmitBytes}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource Brush.TextSecondary}">
                        <Run Text="RX 字节 " />
                        <Run FontWeight="SemiBold" Text="{Binding ReceiveBytes}" />
                    </TextBlock>
                    <TextBlock Margin="0,0,16,0" Foreground="{DynamicResource Brush.Warning}">
                        <Run Text="丢弃 " />
                        <Run FontWeight="SemiBold" Text="{Binding DiscardedBytes}" />
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource Brush.TextMuted}">
                        <Run Text="暂停丢弃 " />
                        <Run FontWeight="SemiBold" Text="{Binding PausedDiscardedBytes}" />
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
