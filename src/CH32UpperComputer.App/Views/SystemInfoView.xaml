<UserControl x:Class="CH32UpperComputer.App.Views.SystemInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="1380">
    <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.PageTitle}" Text="CH32 工业监控上位机" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Caption}" Text="本地运行 · 不访问网络 · 不收集隐私" />
                        <Separator Margin="0,16" Background="{DynamicResource Brush.Border}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                                <RowDefinition Height="34" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Text.Muted}" Text="应用版本" />
                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" />
                            <TextBlock Grid.Row="1" Style="{StaticResource Text.Muted}" Text=".NET" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DotNetVersion}" />
                            <TextBlock Grid.Row="2" Style="{StaticResource Text.Muted}" Text="操作系统" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding OperatingSystem}" TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="协议支持" />
                        <TextBlock Margin="0,10,0,0" Text="{Binding ProtocolSupport}" />
                        <TextBlock Margin="0,7,0,0" Style="{StaticResource Text.Caption}" Text="{Binding RegisterMapVersion}" />
                        <TextBlock Margin="0,14,0,0"
                                   Foreground="{DynamicResource Brush.Warning}"
                                   Text="未知地址查询仅适用于总线上只有一个设备的情况；多设备同时应答会产生总线冲突。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Border Margin="0,0,0,10" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="本地文件位置" />
                        <TextBlock Margin="0,13,0,4" Style="{StaticResource Text.Muted}" Text="配置文件" />
                        <TextBox IsReadOnly="True" Text="{Binding SettingsFilePath, Mode=OneWay}" />
                        <TextBlock Margin="0,13,0,4" Style="{StaticResource Text.Muted}" Text="日志导出目录" />
                        <TextBox IsReadOnly="True" Text="{Binding LogExportDirectory, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.SectionTitle}" Text="使用边界与免责声明" />
                        <TextBlock Margin="0,12,0,0"
                                   FontSize="14"
                                   LineHeight="24"
                                   Text="{Binding Disclaimer}"
                                   TextWrapping="Wrap" />
                        <Separator Margin="0,16" Background="{DynamicResource Brush.Border}" />
                        <TextBlock Style="{StaticResource Text.Caption}"
                                   Text="连接成功后应用仍保持静默；自动发送必须由用户本次会话手动开启，且不会持久化为启用状态。"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
